# Copy to .dev.vars for `yarn dev:donations`. Never commit .dev.vars.
# Mercado Pago test credentials create sandbox checkouts.
MP_ACCESS_TOKEN=
# Cloudflare's always-pass test secret key, paired with the test site key in .env.example.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,example.com
