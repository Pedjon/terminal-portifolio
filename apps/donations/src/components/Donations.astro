---
import { getPortfolio } from '@portfolio/content';
import { MAX_AMOUNT, MIN_AMOUNT, PRESET_AMOUNTS, formatAmount } from '../scripts/amount.js';
import { fillMessage, getMessages } from '../scripts/i18n.js';
import '../styles/global.css';

const { locale = 'en' } = Astro.props;
const portfolio = getPortfolio(locale);
const ui = getMessages(locale);
const websiteUrl = new URL(locale === 'pt-BR' ? 'pt-br/' : '', import.meta.env.PUBLIC_WEB_URL || 'http://localhost:8081/').href;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const limits = { min: formatAmount(MIN_AMOUNT, locale), max: formatAmount(MAX_AMOUNT, locale) };
const title = `${ui.pageTitle} — ${portfolio.profile.name}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={ui.pageDescription} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ui.pageDescription} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        let preference;
        try { preference = localStorage.getItem('portfolio-theme'); } catch {}
        document.documentElement.dataset.theme = preference === 'light' || preference === 'dark'
          ? preference : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipLink}</a>

    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href={websiteUrl}>{portfolio.profile.name}<span aria-hidden="true">.</span></a>

        <div class="header-controls">
          <nav class="language-switch" aria-label={ui.language}>
            <a href="/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
            <span aria-hidden="true">/</span>
            <a href="/pt-br/" lang="pt-BR" hreflang="pt-BR" aria-current={locale === 'pt-BR' ? 'page' : undefined}>PT</a>
          </nav>

          <button id="theme-toggle" class="theme-toggle" type="button" aria-label={ui.darkTheme}
            aria-pressed="false" data-light-label={ui.light} data-dark-label={ui.dark} hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
            <span data-theme-label>{ui.light}</span>
          </button>

          <a class="portfolio-link" href={websiteUrl}>{ui.portfolio}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>

    <main id="main" class="container donations">
      <p id="payment-result" class="payment-result" role="status" hidden></p>

      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{ui.eyebrow}</p>
        <h1 id="page-title">{ui.headline} <em>{ui.headlineAccent}</em></h1>
        <p class="intro-copy">{ui.intro}</p>
      </section>

      <section class="options" aria-labelledby="options-title">
        <h2 id="options-title" class="eyebrow">{ui.options}</h2>

        <article class="option-card">
          <div class="option-heading">
            <span class="option-index" aria-hidden="true">01</span>
            <h3>{ui.mercadoPago}</h3>
          </div>
          <p class="option-description">{ui.mercadoPagoDescription}</p>

          <noscript><p class="notice">{ui.javascriptRequired}</p></noscript>

          <form id="donation-form" class="donation-form" data-locale={locale} novalidate>
            <fieldset class="presets">
              <legend>{ui.presetAmounts}</legend>
              {PRESET_AMOUNTS.map(amount => (
                <button type="button" class="preset" data-amount={amount} aria-pressed="false">
                  {formatAmount(amount, locale)}
                </button>
              ))}
            </fieldset>

            <label class="amount-label" for="donation-amount">{ui.customAmount}</label>
            <div class="amount-field">
              <span aria-hidden="true">R$</span>
              <input id="donation-amount" name="amount" type="text" inputmode="decimal" autocomplete="off"
                placeholder={locale === 'pt-BR' ? '0,00' : '0.00'} aria-describedby="amount-hint" />
            </div>
            <p id="amount-hint" class="amount-hint">{fillMessage(ui.amountHint, limits)}</p>

            <div id="turnstile" class="turnstile" data-sitekey={siteKey}></div>

            <button class="button" type="submit">{ui.donate}<span aria-hidden="true">↗</span></button>
            <p id="donation-status" class="donation-status" role="status" aria-live="polite"></p>
          </form>
        </article>
      </section>
    </main>

    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} {portfolio.profile.name}</p>
      <a class="text-link" href={websiteUrl}>{ui.backToPortfolio}<span aria-hidden="true">↗</span></a>
    </footer>

    <script>
      import { initTheme } from '../scripts/theme.js';
      import { initDonations } from '../scripts/donate.js';
      initTheme();
      initDonations();
    </script>
  </body>
</html>
